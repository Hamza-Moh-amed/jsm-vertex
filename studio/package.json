{
  "name": "jsm-vertex",
  "private": true,
  "version": "1.0.0",
  "main": "package.json",
  "license": "UNLICENSED",
  "scripts": {
    "build": "sanity build",
    "deploy": "sanity deploy",
    "deploy-graphql": "sanity graphql deploy",
    "dev": "sanity dev",
    "start": "sanity start",
    "seed:videos": "node scripts/seed/resolve-videos.mjs",
    "seed:build": "node scripts/seed/build-ndjson.mjs",
    "seed:import": "sanity dataset import scripts/seed/seed.ndjson --dataset production --replace",
    "context:import": "sanity dataset import scripts/context/vertex-search.ndjson --dataset production --replace",
    "ingest:videos": "node scripts/ingest/ingest-videos.mjs",
    "ingest:build": "node scripts/ingest/build-ndjson.mjs",
    "ingest:import": "sanity dataset import scripts/ingest/videos.ndjson --dataset production --replace"
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@sanity/vision": "^6.13.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sanity": "^6.13.1",
    "styled-components": "^6.1.18"
  },
  "devDependencies": {
    "@sanity/eslint-config-studio": "^7",
    "@types/react": "^19.2.14",
    "eslint": "^10.8.1",
    "prettier": "^3.5",
    "typescript": "^5.8"
  },
  "prettier": {
    "bracketSpacing": false,
    "printWidth": 100,
    "semi": false,
    "singleQuote": true
  }
}
